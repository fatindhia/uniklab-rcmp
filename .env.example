APP_NAME="UniKLAB RCMP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://uniklab-rcmp.test
# Booking times are local. On UTC, the "past date / already-passed slot" checks
# are 8 hours out and let a finished slot through.
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Public holiday feed for the calendars and the booking-form warning. PRK
# (Perak) returns federal + state holidays merged. Only the scheduled
# holidays:sync command calls this.
HOLIDAY_STATE=PRK

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lab_booking
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database

CACHE_STORE=database

# Defaults to local Mailpit (http://localhost:8025) so a fresh checkout never
# sends real mail. For live sending use the Microsoft SMTP host — 587 +
# MAIL_SCHEME=smtp is STARTTLS:
#   MAIL_HOST=smtp-mail.outlook.com   (personal Microsoft account)
#   MAIL_HOST=smtp.office365.com      (UniKL tenant)
# MAIL_PASSWORD must be an app password when the account has MFA enabled.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=smtp
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@unikl.edu.my"
MAIL_FROM_NAME="UniKLAB RCMP"

# Microsoft Entra ID (Azure AD) sign-in for the admin panel.
#   SSO_ENABLED=false  local / Docker / maintenance — Staff ID + password form only
#   SSO_ENABLED=true   production — "Sign in with Microsoft" only, password form off
# Either way only an existing, active account with a panel role (Lab Staff,
# Admin, Super Admin) gets in; a Microsoft sign-in never creates an account or
# grants a role. The AZURE_* values are only read when SSO_ENABLED=true.
# Never commit real values — the client secret belongs in the server's .env only.
# Production also needs APP_URL=https://uniklab.rcmp.edu.my
SSO_ENABLED=false
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# The UniKL tenant ID (a GUID), not "common" or "organizations".
AZURE_TENANT_ID=
# Must match the Redirect URI on the Entra app registration exactly.
AZURE_REDIRECT_URI=https://uniklab.rcmp.edu.my/api/auth/microsoft/callback
AZURE_OAUTH_SCOPES="openid profile email offline_access User.Read"
AZURE_GRAPH_API_URL=https://graph.microsoft.com/v1.0
AZURE_GRAPH_ME_PATH=/me
AZURE_GRAPH_ME_SELECT="id,displayName,mail,userPrincipalName,jobTitle,officeLocation"
# Comma-separated, exact match — unikl.edu.my does not cover s.unikl.edu.my (students).
SSO_ALLOWED_EMAIL_DOMAINS=unikl.edu.my
